# Sample configuration. Copy to .env (git-ignored) or set these as environment variables.
# The app has working defaults for a local PostgreSQL; change them only if your setup differs.

# --- web app (backend/db.py) ---------------------------------------------
OLIST_DB_HOST=localhost
OLIST_DB_PORT=5432
OLIST_DB_NAME=olist
OLIST_DB_USER=olist_app
# demo password created by db/08_security.sql; change it there and here for any real use
OLIST_DB_PASSWORD=change_me
# Flask session key; a random one is generated at start if empty
OLIST_SECRET_KEY=
PORT=5000

# --- ML training (ml/common.py, standard libpq variables) ----------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=olist
PGUSER=postgres
PGPASSWORD=
